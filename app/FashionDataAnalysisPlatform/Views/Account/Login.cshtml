@{
    Layout = null;
    ViewData["Title"] = "Sign In — FashionBI";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/x-icon"  href="/favicon.ico" />
</head>
<body class="login-body">

    <div class="login-page">

        <div class="login-card">

            <!-- Brand -->
            <div class="login-brand">
                <div class="login-brand-icon">
                    <partial name="_LogoIcon" />
                </div>
                <div>
                    <div class="login-brand-title">FashionBI</div>
                    <div class="login-brand-subtitle">Retail Intelligence</div>
                </div>
            </div>

            <h1 class="login-heading">Welcome back</h1>
            <p class="login-subheading">Sign in to your analytics workspace</p>

            @if (!string.IsNullOrEmpty(ViewBag.Error as string))
            {
                <div class="login-error-banner">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    @ViewBag.Error
                </div>
            }

            <form method="post" asp-controller="Account" asp-action="Login" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="login-field">
                    <label class="login-label" for="email">Email address</label>
                    <input class="login-input"
                           type="email"
                           id="email"
                           name="email"
                           placeholder="you@example.com"
                           autocomplete="email"
                           required />
                </div>

                <div class="login-field">
                    <label class="login-label" for="password">Password</label>
                    <div class="login-input-wrap">
                        <input class="login-input"
                               type="password"
                               id="password"
                               name="password"
                               placeholder="••••••••••"
                               autocomplete="current-password"
                               required />
                        <button type="button" class="login-eye" onclick="togglePassword()" aria-label="Show password">
                            <i class="fa-regular fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="login-submit">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                    Sign In
                </button>
            </form>

            <!-- Demonstration access panel -->
            <div class="demo-panel">
                <div class="demo-panel-header">
                    <i class="fa-solid fa-key"></i>
                    <span>Demonstration Access</span>
                </div>
                <p class="demo-panel-note">
                    Access the pre-configured analytics workspace with a single click.
                </p>
                <form method="post" asp-controller="Account" asp-action="DemoLogin">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <button type="submit" class="demo-fill-btn">
                        <i class="fa-solid fa-bolt"></i>
                        Enter Analytics Workspace
                    </button>
                </form>
            </div>

        </div>

    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById('password');
            const icon  = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }
    </script>

</body>
</html>
