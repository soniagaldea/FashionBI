                    <div class="chart-card-subtitle">Business intelligence from real sales data</div>
                </div>
                <span class="kpi-pill emerald" style="font-size:11px;" id="saInsightCount">0</span>
            </div>
            <div class="card-body" id="saInsightsBody" style="overflow-y:auto; max-height:360px;">
