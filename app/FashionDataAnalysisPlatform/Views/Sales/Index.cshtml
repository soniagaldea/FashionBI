    </div>

</div>

@section Scripts {

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
(function () {

    // ── Design tokens ────────────────────────────────────────────────
    const C_INDIGO  = '#5b5fc7';
    const C_EMERALD = '#10b981';
    const C_AMBER   = '#f59e0b';
    const C_ROSE    = '#f43f5e';
    const C_VIOLET  = '#8b5cf6';
    const C_CYAN    = '#06b6d4';
    const C_PINK    = '#ec4899';
    const C_LIME    = '#84cc16';

    const FONT_FAMILY = "'Inter', 'Segoe UI', sans-serif";
    const TEXT_MUTED  = '#94a3b8';
    const BORDER_CLR  = '#e8ecf2';

    Chart.defaults.font.family = FONT_FAMILY;
    Chart.defaults.font.size   = 12;
    Chart.defaults.color       = TEXT_MUTED;

    const gridOpts = { color: BORDER_CLR, lineWidth: 1, drawBorder: false };
    const tickOpts = { color: TEXT_MUTED, font: { size: 11 } };

    // ── Server data ──────────────────────────────────────────────────
    const trendLabels        = @Html.Raw(ViewBag.TrendLabels         ?? "[]");
    const trendRevenue       = @Html.Raw(ViewBag.TrendRevenue        ?? "[]");
    const aovValues          = @Html.Raw(ViewBag.AovValues           ?? "[]");
    const trendGranularity   = '@(ViewBag.TrendGranularity ?? "monthly")';
    const discountBandLabels = @Html.Raw(ViewBag.DiscountBandLabels  ?? "[]");
    const discountBandCounts = @Html.Raw(ViewBag.DiscountBandCounts  ?? "[]");
    const discountBandRev    = @Html.Raw(ViewBag.DiscountBandRevenue ?? "[]");
    const discountBandMargin = @Html.Raw(ViewBag.DiscountBandMargin  ?? "[]");
    const topProducts        = @Html.Raw(ViewBag.TopProducts         ?? "[]");
    const colorLabels        = @Html.Raw(ViewBag.ColorLabels         ?? "[]");
    const colorUnits         = @Html.Raw(ViewBag.ColorUnits          ?? "[]");
    const colorRevenue       = @Html.Raw(ViewBag.ColorRevenue        ?? "[]");
    const sizeLabels         = @Html.Raw(ViewBag.SizeLabels          ?? "[]");
    const sizeUnits          = @Html.Raw(ViewBag.SizeUnits           ?? "[]");
    const channelSplit       = @Html.Raw(ViewBag.ChannelSplit        ?? "[]");
    const smartInsights      = @Html.Raw(ViewBag.SmartInsights       ?? "[]");

    // ── Shared axis helpers ──────────────────────────────────────────
    function revTick(v) { return '€' + (v >= 1e6 ? (v/1e6).toFixed(1)+'M' : v >= 1e3 ? (v/1e3).toFixed(0)+'k' : v); }
    function aovTick(v) { return '€' + (v >= 1e3 ? (v/1e3).toFixed(1)+'k' : v); }
    function unitTick(v){ return v >= 1e3 ? (v/1e3).toFixed(0)+'k' : v; }

    function pointConfig(n) {
        return { ptRadius: n <= 7 ? 4 : n <= 14 ? 3 : n <= 31 ? 2 : 0, ptHover: n <= 31 ? 5 : 3 };
    }
    function maxTicks(n, gran) {
        return gran === 'daily' && n > 10 ? 10 : gran === 'monthly' && n > 18 ? 12 : n;
    }
    const tension = trendGranularity === 'daily' ? 0.15 : 0.38;

    // ── 1. Revenue Over Time ─────────────────────────────────────────
    const revCtx = document.getElementById('saRevenueTrendChart');
    if (revCtx && trendLabels.length) {
        const n   = trendLabels.length;
        const { ptRadius, ptHover } = pointConfig(n);
        new Chart(revCtx, {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [{
                    label: 'Revenue',
                    data: trendRevenue,
                    borderColor: C_INDIGO,
                    backgroundColor: 'rgba(91,95,199,0.08)',
                    borderWidth: 2.5,
                    pointRadius: ptRadius,
                    pointHoverRadius: ptHover,
                    fill: true,
                    tension
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#fff', borderColor: BORDER_CLR, borderWidth: 1,
                        titleColor: '#1e293b', bodyColor: '#475569', padding: 12,
                        callbacks: { label: ctx => ` Revenue: €${ctx.parsed.y.toLocaleString('en', { minimumFractionDigits: 2 })}` }
                    }
                },
                scales: {
                    x: { grid: { ...gridOpts, drawOnChartArea: false }, ticks: { ...tickOpts, maxTicksLimit: maxTicks(n, trendGranularity), maxRotation: trendGranularity === 'daily' && n > 14 ? 45 : 0 } },
                    y: { grid: gridOpts, ticks: { ...tickOpts, callback: revTick }, beginAtZero: true }
                }
            }
        });
    }

    // ── 2. AOV Trend ─────────────────────────────────────────────────
    const aovCtx = document.getElementById('saAovChart');
    if (aovCtx && trendLabels.length) {
        const n   = trendLabels.length;
        const { ptRadius, ptHover } = pointConfig(n);
        new Chart(aovCtx, {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [{
                    label: 'AOV',
                    data: aovValues,
                    borderColor: C_AMBER,
                    backgroundColor: 'rgba(245,158,11,0.08)',
                    borderWidth: 2,
                    pointRadius: ptRadius,
                    pointHoverRadius: ptHover,
                    fill: true,
                    tension
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#fff', borderColor: BORDER_CLR, borderWidth: 1,
                        titleColor: '#1e293b', bodyColor: '#475569', padding: 12,
                        callbacks: { label: ctx => ` AOV: €${ctx.parsed.y.toLocaleString('en', { minimumFractionDigits: 2 })}` }
                    }
                },
                scales: {
                    x: { grid: { ...gridOpts, drawOnChartArea: false }, ticks: { ...tickOpts, maxTicksLimit: maxTicks(n, trendGranularity), maxRotation: 0 } },
                    y: { grid: gridOpts, ticks: { ...tickOpts, callback: aovTick }, beginAtZero: false }
                }
            }
        });
    }

    // ── 3. Discount Efficiency (mixed bar + line) ─────────────────────
    const discCtx = document.getElementById('saDiscountChart');
    if (discCtx && discountBandLabels.length) {
        // Bars grade green → red to show risk level of each band
        const bandFill   = ['rgba(16,185,129,.75)', 'rgba(132,204,22,.75)', 'rgba(245,158,11,.75)', 'rgba(249,115,22,.75)', 'rgba(239,68,68,.75)'];
        const bandBorder = ['#10b981', '#84cc16', '#f59e0b', '#f97316', '#ef4444'];
        new Chart(discCtx, {
            type: 'bar',
            data: {
                labels: discountBandLabels,
                datasets: [
                    {
                        type: 'bar',
                        label: 'Revenue',
                        data: discountBandRev,
                        backgroundColor: bandFill,
                        borderColor: bandBorder,
                        borderWidth: 1.5,
                        borderRadius: 6,
                        borderSkipped: false,
                        barPercentage: 0.6,
                        categoryPercentage: 0.75,
                        yAxisID: 'yRev',
                        order: 2
                    },
                    {
                        type: 'line',
                        label: 'Margin %',
                        data: discountBandMargin,
                        borderColor: C_INDIGO,
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        tension: 0.3,
                        yAxisID: 'yMargin',
                        order: 1
                    }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#fff', borderColor: BORDER_CLR, borderWidth: 1,
                        titleColor: '#1e293b', bodyColor: '#475569', padding: 12,
                        callbacks: {
                            label: ctx => ctx.dataset.label === 'Revenue'
                                ? ` Revenue: €${ctx.parsed.y.toLocaleString('en', { minimumFractionDigits: 2 })}`
                                : ` Margin: ${ctx.parsed.y.toFixed(1)}%`,
                            afterLabel: ctx => ctx.dataset.label === 'Revenue'
                                ? ` Orders: ${discountBandCounts[ctx.dataIndex].toLocaleString('en')}`
                                : ''
                        }
                    }
                },
                scales: {
                    x:       { grid: { ...gridOpts, drawOnChartArea: false }, ticks: tickOpts },
                    yRev:    { position: 'left',  grid: gridOpts, ticks: { ...tickOpts, callback: revTick }, beginAtZero: true, title: { display: true, text: 'Revenue', color: TEXT_MUTED, font: { size: 11 } } },
                    yMargin: { position: 'right', grid: { display: false }, ticks: { ...tickOpts, callback: v => v + '%' }, title: { display: true, text: 'Margin %', color: TEXT_MUTED, font: { size: 11 } } }
                }
            }
        });
    }

    // ── 4. Top Performing Products ───────────────────────────────────
    (function () {
        const el = document.getElementById('saTopProductsTbody');
        if (!el) return;
        if (!topProducts.length) {
            el.innerHTML = '<tr><td colspan="6" style="padding:20px;text-align:center;color:var(--muted);">No product data for this period.</td></tr>';
            return;
        }
        el.innerHTML = topProducts.map((p, i) => {
            const mCls = p.margin >= 25 ? 'high' : p.margin >= 10 ? 'medium' : 'low';
            const rev  = p.revenue.toLocaleString('en', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            return `<tr>
                <td><span class="top-products-rank">${i + 1}</span></td>
                <td><span class="top-products-name">${p.name}</span></td>
                <td><span class="top-products-cat">${p.category}</span></td>
                <td style="text-align:right;font-weight:600;color:var(--text-secondary);">€${rev}</td>
                <td style="text-align:right;color:var(--text-tertiary);">${p.units.toLocaleString('en')}</td>
                <td style="text-align:right;"><span class="top-products-margin ${mCls}">${p.margin.toFixed(1)}%</span></td>
            </tr>`;
        }).join('');
    })();

    // ── 5. Colour Performance (horizontal bar) ───────────────────────
    const colorCtx = document.getElementById('saColorChart');
    if (colorCtx && colorLabels.length) {
        const palette = [C_INDIGO, C_VIOLET, C_CYAN, C_PINK, C_ROSE, C_EMERALD];
        new Chart(colorCtx, {
            type: 'bar',
            data: {
                labels: colorLabels,
                datasets: [{
                    label: 'Units',
                    data: colorUnits,
                    backgroundColor: colorLabels.map((_, i) => palette[i % palette.length] + 'cc'),
                    borderColor:     colorLabels.map((_, i) => palette[i % palette.length]),
                    borderWidth: 1.5,
                    borderRadius: 4,
                    borderSkipped: false,
                    barPercentage: 0.65,
                    categoryPercentage: 0.75
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#fff', borderColor: BORDER_CLR, borderWidth: 1,
                        titleColor: '#1e293b', bodyColor: '#475569', padding: 12,
                        callbacks: {
                            label: ctx => ` Units: ${ctx.parsed.x.toLocaleString('en')}`,
                            afterLabel: ctx => ` Revenue: €${colorRevenue[ctx.dataIndex].toLocaleString('en', { minimumFractionDigits: 2 })}`
                        }
                    }
                },
                scales: {
                    x: { grid: gridOpts, ticks: { ...tickOpts, callback: unitTick }, beginAtZero: true },
                    y: { grid: { display: false }, ticks: tickOpts }
                }
            }
        });
    }

    // ── 6. Size Performance (vertical bar) ──────────────────────────
    const sizeCtx = document.getElementById('saSizeChart');
    if (sizeCtx && sizeLabels.length) {
        const maxVal = sizeUnits.length ? Math.max(...sizeUnits) : 1;
        const sizeFill = sizeUnits.map(v => {
            const t = maxVal > 0 ? v / maxVal : 0;
            return `rgba(91,95,199,${(0.3 + t * 0.7).toFixed(2)})`;
        });
        new Chart(sizeCtx, {
            type: 'bar',
            data: {
                labels: sizeLabels,
                datasets: [{
                    label: 'Units Sold',
                    data: sizeUnits,
                    backgroundColor: sizeFill,
                    borderColor: C_INDIGO,
                    borderWidth: 1.5,
                    borderRadius: 6,
                    borderSkipped: false,
                    barPercentage: 0.6,
                    categoryPercentage: 0.75
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#fff', borderColor: BORDER_CLR, borderWidth: 1,
                        titleColor: '#1e293b', bodyColor: '#475569', padding: 12,
                        callbacks: { label: ctx => ` Units: ${ctx.parsed.y.toLocaleString('en')}` }
                    }
                },
                scales: {
                    x: { grid: { ...gridOpts, drawOnChartArea: false }, ticks: tickOpts },
                    y: { grid: gridOpts, ticks: { ...tickOpts, callback: unitTick }, beginAtZero: true }
                }
            }
        });
    }

    // ── 7. Channel Split table ───────────────────────────────────────
    (function () {
        const el = document.getElementById('saChannelTbody');
        if (!el) return;
        if (!channelSplit.length) {
            el.innerHTML = '<tr><td colspan="4" style="padding:20px;text-align:center;color:var(--muted);">No channel data for this period.</td></tr>';
            return;
        }
        const chanColors = [C_INDIGO, C_EMERALD, C_AMBER, C_ROSE, C_VIOLET, C_CYAN];
        el.innerHTML = channelSplit.map((c, i) => {
            const rev = c.revenue.toLocaleString('en', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const aov = c.aov.toLocaleString('en',     { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const col = chanColors[i % chanColors.length];
            return `<tr>
                <td style="font-weight:500;color:var(--text-secondary);">${c.channel}</td>
                <td style="text-align:right;font-weight:600;color:var(--text-secondary);">€${rev}</td>
                <td>
                    <div class="sa-share-bar">
                        <div class="sa-share-bar-track">
                            <div class="sa-share-bar-fill" style="width:${c.share}%;background:${col};"></div>
                        </div>
                        <span style="font-size:11.5px;font-weight:600;color:var(--text-tertiary);white-space:nowrap;">${c.share}%</span>
                    </div>
                </td>
                <td style="text-align:right;color:var(--muted);">€${aov}</td>
            </tr>`;
        }).join('');
    })();

    // ── 8. Smart Insights ────────────────────────────────────────────
    (function () {
        const el    = document.getElementById('saInsightsBody');
        const badge = document.getElementById('saInsightCount');
        if (!el || !smartInsights.length) return;
        const tagMap = { success: 'success', warning: 'warning', danger: 'danger', info: 'info', primary: 'info' };
        el.innerHTML = smartInsights.map(it =>
            `<div class="alert-item ${tagMap[it.tag] || 'info'}" style="margin-bottom:8px;">
                <i class="fa-solid ${it.icon}"></i>
                <div><div class="alert-item-title">${it.title}</div>${it.body}</div>
            </div>`
        ).join('');
        if (badge) badge.textContent = smartInsights.length + ' insights';
    })();

})();

window.setDateRange = function (range) {
    const url = new URL(window.location.href);
    url.searchParams.set('dateRange', range);
    window.location.href = url.toString();
};
</script>

}
