@model ErrorViewModel
@{
    ViewData["Title"] = "Error — FashionBI";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dash-header" style="margin-bottom:24px;">
    <div>
        <h1 class="dash-title">Something went wrong</h1>
        <p class="dash-subtitle">An unexpected error occurred while processing your request.</p>
    </div>
</div>

<div class="card" style="max-width:600px;padding:32px 36px;text-align:center;">

    <div style="font-size:48px;color:var(--red-500,#ef4444);margin-bottom:16px;">
        <i class="fa-solid fa-triangle-exclamation"></i>
    </div>

    <p style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">
        FashionBI encountered an error and could not complete the requested operation.
        Please try again or navigate to a different section of the platform.
    </p>

    @if (Model?.ShowRequestId == true)
    {
        <p style="font-size:12px;color:var(--text-tertiary,#9ca3af);margin-bottom:24px;">
            Reference: <code style="font-size:11px;">@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Dashboard" asp-action="Index"
       class="btn-primary"
       style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:10px;text-decoration:none;font-size:14px;font-weight:500;">
        <i class="fa-solid fa-chart-line"></i>
        Return to Dashboard
    </a>

</div>
